@*
    Edit Listing

    This page allows a logged-in CLS member to update a listing they own.
    Ownership is checked by ListingsController before the edit page is displayed
    and again when the changes are submitted.

    MemberID, CLSNumber, and DateListed are controlled by CLS and cannot
    be changed from this form.
*@

@model CLSWeb.Models.Listing

@{
    // Set the title shown in the browser.
    ViewData["Title"] = "Edit Listing";
}

<div class="container mt-4">

    @* Introduce the edit form to the member. *@
    <div class="mb-4">

        <h1>Edit Listing</h1>

        <p class="text-muted">
            Update the property information below.
        </p>

    </div>

    @* Show information that identifies the listing but cannot be changed here. *@
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Listing Information</strong>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        CLS Number
                    </label>

                    @* The CLS number is assigned by CLS and is not editable. *@
                    <input type="text"
                           class="form-control"
                           value="@Model.CLSNumber"
                           disabled />

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Listing Agent
                    </label>

                    @* The listing agent is shown for reference and cannot be changed here. *@
                    <input type="text"
                           class="form-control"
                           value="@ViewBag.ListingAgent"
                           disabled />

                </div>

            </div>

        </div>

    </div>

    @*
        Send the updated property information to the Edit action.
        The ListingID is included in the route so the controller knows
        which listing is being updated.
    *@
    <form asp-controller="Listings"
          asp-action="Edit"
          asp-route-id="@Model.ListingID"
          method="post">

        @* Protect the update request from cross-site request forgery. *@
        @Html.AntiForgeryToken()

        @*
            Send the ListingID back with the form.
            The controller verifies the ID and listing ownership before saving changes.
        *@
        <input type="hidden"
               asp-for="ListingID" />

        @* Show any validation errors that prevent the changes from being saved. *@
        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        @* Update the basic property information. *@
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Property Information</strong>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="PropertyType"
                               class="form-label">
                            Property Type
                        </label>

                        @* Razor selects the property's current value when the page loads. *@
                        <select asp-for="PropertyType"
                                class="form-select">

                            <option value="">
                                Select Property Type
                            </option>

                            <option value="Single Family">
                                Single Family
                            </option>

                            <option value="Condo">
                                Condo
                            </option>

                            <option value="Townhouse">
                                Townhouse
                            </option>

                            <option value="Multi-Family">
                                Multi-Family
                            </option>

                            <option value="Land">
                                Land
                            </option>

                        </select>

                        <span asp-validation-for="PropertyType"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="PropertyStatus"
                               class="form-label">
                            Property Status
                        </label>

                        @* The status can be updated as the property moves through the listing process. *@
                        <select asp-for="PropertyStatus"
                                class="form-select">

                            <option value="">
                                Select Property Status
                            </option>

                            <option value="Active">
                                Active
                            </option>

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Coming Soon">
                                Coming Soon
                            </option>

                            <option value="Contingent">
                                Contingent
                            </option>

                        </select>

                        <span asp-validation-for="PropertyStatus"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12 mb-3">

                        <label asp-for="StreetAddress"
                               class="form-label">
                            Street Address
                        </label>

                        <input asp-for="StreetAddress"
                               class="form-control" />

                        <span asp-validation-for="StreetAddress"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-5 mb-3">

                        <label asp-for="City"
                               class="form-label">
                            City
                        </label>

                        <input asp-for="City"
                               class="form-control" />

                        <span asp-validation-for="City"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3 mb-3">

                        <label asp-for="State"
                               class="form-label">
                            State
                        </label>

                        @* CLS currently supports Illinois listings for this project. *@
                        <select asp-for="State"
                                class="form-select">

                            <option value="IL">
                                Illinois
                            </option>

                        </select>

                        <span asp-validation-for="State"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="ZipCode"
                               class="form-label">
                            ZIP Code
                        </label>

                        <input asp-for="ZipCode"
                               class="form-control" />

                        <span asp-validation-for="ZipCode"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>

        @* Update the price and physical details of the property. *@
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Pricing and Property Details</strong>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label asp-for="ListPrice"
                               class="form-label">
                            List Price
                        </label>

                        @* Allow cents while preventing a negative price in the browser. *@
                        <input asp-for="ListPrice"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="ListPrice"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="Bedrooms"
                               class="form-label">
                            Bedrooms
                        </label>

                        <input asp-for="Bedrooms"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="Bedrooms"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="Bathrooms"
                               class="form-label">
                            Bathrooms
                        </label>

                        @* Half-bath increments allow values such as 1.5 or 2.5. *@
                        <input asp-for="Bathrooms"
                               type="number"
                               step="0.5"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="Bathrooms"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="SquareFeet"
                               class="form-label">
                            Square Feet
                        </label>

                        <input asp-for="SquareFeet"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="SquareFeet"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="YearBuilt"
                               class="form-label">
                            Year Built
                        </label>

                        <input asp-for="YearBuilt"
                               type="number"
                               min="1800"
                               class="form-control" />

                        <span asp-validation-for="YearBuilt"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="HOAFees"
                               class="form-label">
                            HOA Fees
                        </label>

                        <input asp-for="HOAFees"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="HOAFees"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>

        @* Allow the property description to be updated. *@
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Listing Description</strong>
            </div>

            <div class="card-body">

                <label asp-for="ListingDescription"
                       class="form-label">
                    Property Description
                </label>

                <textarea asp-for="ListingDescription"
                          class="form-control"
                          rows="6"></textarea>

                <span asp-validation-for="ListingDescription"
                      class="text-danger">
                </span>

            </div>

        </div>

        @* Save the changes or return to My Listings without updating the property. *@
        <div class="d-flex gap-2 mb-5">

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-controller="Listings"
               asp-action="MyListings"
               class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts
{
    @*
        Load client-side validation so supported errors can be shown
        before the updated listing is sent to the server.
    *@
    <partial name="_ValidationScriptsPartial" />
}