@*
    Create Listing

    This page allows a logged-in CLS member to create a new property listing.
    MemberID, CLSNumber, and DateListed are assigned automatically by
    ListingsController instead of being entered on the form.
*@

@model CLSWeb.Models.Listing

@{
    // Set the title shown in the browser.
    ViewData["Title"] = "Create Listing";
}

<div class="container mt-4">

    @* Introduce the form to the member. *@
    <div class="mb-4">
        <h1>Add New Listing</h1>

        <p class="text-muted">
            Enter the property information below.
        </p>
    </div>

    @*
        Send the completed listing to the Create action in ListingsController.
        POST keeps the submitted property information out of the URL.
    *@
    <form asp-controller="Listings"
          asp-action="Create"
          method="post">

        @* Protect the form from cross-site request forgery. *@
        @Html.AntiForgeryToken()

        @* Show any validation errors that prevent the listing from being created. *@
        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        @* Basic information about the property. *@
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Property Information</strong>
            </div>

            <div class="card-body">

                <div class="row">

                    @* Choose the type of property being listed. *@
                    <div class="col-md-6 mb-3">

                        <label asp-for="PropertyType"
                               class="form-label">
                            Property Type
                        </label>

                        <select asp-for="PropertyType"
                                class="form-select">

                            <option value="">
                                Select Property Type
                            </option>

                            <option value="Single Family">
                                Single Family
                            </option>

                            <option value="Condo">
                                Condo
                            </option>

                            <option value="Townhouse">
                                Townhouse
                            </option>

                            <option value="Multi-Family">
                                Multi-Family
                            </option>

                            <option value="Land">
                                Land
                            </option>

                        </select>

                        <span asp-validation-for="PropertyType"
                              class="text-danger">
                        </span>

                    </div>

                    @* Set the current status of the listing. *@
                    <div class="col-md-6 mb-3">

                        <label asp-for="PropertyStatus"
                               class="form-label">
                            Property Status
                        </label>

                        <select asp-for="PropertyStatus"
                                class="form-select">

                            <option value="">
                                Select Property Status
                            </option>

                            <option value="Active">
                                Active
                            </option>

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Coming Soon">
                                Coming Soon
                            </option>

                            <option value="Contingent">
                                Contingent
                            </option>

                        </select>

                        <span asp-validation-for="PropertyStatus"
                              class="text-danger">
                        </span>

                    </div>

                    @* Enter the street address for the property. *@
                    <div class="col-12 mb-3">

                        <label asp-for="StreetAddress"
                               class="form-label">
                            Street Address
                        </label>

                        <input asp-for="StreetAddress"
                               class="form-control"
                               placeholder="Example: 123 Main Street" />

                        <span asp-validation-for="StreetAddress"
                              class="text-danger">
                        </span>

                    </div>

                    @* Enter the city. *@
                    <div class="col-md-5 mb-3">

                        <label asp-for="City"
                               class="form-label">
                            City
                        </label>

                        <input asp-for="City"
                               class="form-control"
                               placeholder="Chicago" />

                        <span asp-validation-for="City"
                              class="text-danger">
                        </span>

                    </div>

                    @*
                        CLS currently focuses on Chicago-area properties,
                        so Illinois is the only state available for this project.
                    *@
                    <div class="col-md-3 mb-3">

                        <label asp-for="State"
                               class="form-label">
                            State
                        </label>

                        <select asp-for="State"
                                class="form-select">

                            <option value="IL">
                                Illinois
                            </option>

                        </select>

                        <span asp-validation-for="State"
                              class="text-danger">
                        </span>

                    </div>

                    @* Enter the property's ZIP code. *@
                    <div class="col-md-4 mb-3">

                        <label asp-for="ZipCode"
                               class="form-label">
                            ZIP Code
                        </label>

                        <input asp-for="ZipCode"
                               class="form-control"
                               placeholder="60601" />

                        <span asp-validation-for="ZipCode"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>
        </div>

        @* Enter the price and physical details of the property. *@
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Pricing and Property Details</strong>
            </div>

            <div class="card-body">

                <div class="row">

                    @*
                        The list price accepts cents when needed and prevents
                        a negative value from being entered in the browser.
                    *@
                    <div class="col-md-4 mb-3">

                        <label asp-for="ListPrice"
                               class="form-label">
                            List Price
                        </label>

                        <input asp-for="ListPrice"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="450000" />

                        <span asp-validation-for="ListPrice"
                              class="text-danger">
                        </span>

                    </div>

                    @* Enter the number of bedrooms. *@
                    <div class="col-md-4 mb-3">

                        <label asp-for="Bedrooms"
                               class="form-label">
                            Bedrooms
                        </label>

                        <input asp-for="Bedrooms"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="Bedrooms"
                              class="text-danger">
                        </span>

                    </div>

                    @*
                        Bathrooms can be entered in half-bath increments,
                        such as 1.5, 2, or 2.5.
                    *@
                    <div class="col-md-4 mb-3">

                        <label asp-for="Bathrooms"
                               class="form-label">
                            Bathrooms
                        </label>

                        <input asp-for="Bathrooms"
                               type="number"
                               step="0.5"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="Bathrooms"
                              class="text-danger">
                        </span>

                    </div>

                    @* Enter the total square footage of the property. *@
                    <div class="col-md-4 mb-3">

                        <label asp-for="SquareFeet"
                               class="form-label">
                            Square Feet
                        </label>

                        <input asp-for="SquareFeet"
                               type="number"
                               min="0"
                               class="form-control"
                               placeholder="1500" />

                        <span asp-validation-for="SquareFeet"
                              class="text-danger">
                        </span>

                    </div>

                    @* Enter the year the property was built. *@
                    <div class="col-md-4 mb-3">

                        <label asp-for="YearBuilt"
                               class="form-label">
                            Year Built
                        </label>

                        <input asp-for="YearBuilt"
                               type="number"
                               min="1800"
                               class="form-control"
                               placeholder="2005" />

                        <span asp-validation-for="YearBuilt"
                              class="text-danger">
                        </span>

                    </div>

                    @* Enter HOA fees when they apply to the property. *@
                    <div class="col-md-4 mb-3">

                        <label asp-for="HOAFees"
                               class="form-label">
                            HOA Fees
                        </label>

                        <input asp-for="HOAFees"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="0.00" />

                        <span asp-validation-for="HOAFees"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>
        </div>

        @* Give the member room to describe the property in more detail. *@
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Listing Description</strong>
            </div>

            <div class="card-body">

                <label asp-for="ListingDescription"
                       class="form-label">
                    Property Description
                </label>

                <textarea asp-for="ListingDescription"
                          class="form-control"
                          rows="6"
                          placeholder="Enter a description of the property...">
                </textarea>

                <span asp-validation-for="ListingDescription"
                      class="text-danger">
                </span>

            </div>
        </div>

        @* Create the listing or return to My Listings without saving. *@
        <div class="d-flex gap-2 mb-5">

            <button type="submit"
                    class="btn btn-primary">
                Create Listing
            </button>

            <a asp-controller="Listings"
               asp-action="MyListings"
               class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts
{
    @*
        Load the client-side validation scripts so basic validation
        errors can appear before the form is submitted.
    *@
    <partial name="_ValidationScriptsPartial" />
}