@*
    Listing Details

    Displays the full information for a single CLS property listing,
    including the listing member and any property photos.

    Members can view any listing, but photo management options are
    only shown to the member who owns the listing.
*@

@model CLSWeb.Models.Listing

@{
    // Use the CLS number as the browser title for this listing.
    ViewData["Title"] = $"CLS #{Model.CLSNumber}";

    // Get the logged-in member so we can determine whether they own this listing.
    var loggedInMemberID =
        Context.Session.GetInt32("MemberID");

    // This controls whether the photo management buttons are displayed.
    // ListingsController still performs its own ownership checks for security.
    var ownsListing =
        loggedInMemberID.HasValue &&
        loggedInMemberID.Value == Model.MemberID;
}

<div class="container mt-4">

    @* Return to the page that the member used to open the listing. *@
    <div class="mb-3">

        @if (ViewBag.ReturnTo == "MyListings")
        {
            <a asp-controller="Listings"
               asp-action="MyListings"
               class="btn btn-outline-secondary">
                Back to My Listings
            </a>
        }
        else
        {
            <a asp-controller="Listings"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Property Listings
            </a>
        }

    </div>

    @*
        The page is split into two sections:
        property photos on the left and listing information on the right.
    *@
    <div class="row">

        <div class="col-lg-8">

            @* Display the property's photos when at least one has been uploaded. *@
            @if (Model.Photos.Any())
            {
                <div class="row">

                    @* Show the photos in the order they were uploaded. *@
                    @foreach (var photo in Model.Photos.OrderBy(p => p.UploadDate))
                    {
                        <div class="col-md-6 mb-4">

                            <img src="@photo.PhotoURL"
                                 class="img-fluid rounded shadow-sm"
                                 alt="@(string.IsNullOrWhiteSpace(photo.Caption)
                                     ? "Property photo"
                                     : photo.Caption)"
                                 style="width: 100%; height: 300px; object-fit: cover;" />

                            @* Only show the caption when one was entered for the photo. *@
                            @if (!string.IsNullOrWhiteSpace(photo.Caption))
                            {
                                <p class="text-muted mt-2 mb-2">
                                    @photo.Caption
                                </p>
                            }

                            @*
                                Only the listing owner sees the Delete Photo button.
                                The controller checks ownership again before deleting the photo.
                            *@
                            @if (ownsListing)
                            {
                                <form asp-controller="Listings"
                                      asp-action="DeletePhoto"
                                      asp-route-id="@photo.PhotoID"
                                      method="post"
                                      class="mt-2">

                                    @* Protect the delete request from cross-site request forgery. *@
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to delete this photo?');">
                                        Delete Photo
                                    </button>

                                </form>
                            }

                        </div>
                    }

                </div>
            }
            else
            {
                @* Show a placeholder when the listing does not have any photos yet. *@
                <div class="bg-light d-flex align-items-center justify-content-center rounded"
                     style="height: 350px;">

                    <span class="text-muted">
                        No photos available
                    </span>

                </div>
            }

        </div>

        <div class="col-lg-4">

            @* Display the main property information. *@
            <h1>
                @Model.StreetAddress
            </h1>

            <p class="lead">
                @Model.City, @Model.State @Model.ZipCode
            </p>

            @* Display the list price as currency without decimal places. *@
            <h2 class="text-primary">
                @Model.ListPrice.ToString("C0")
            </h2>

            @*
                Only the listing owner can add photos.
                The controller also verifies ownership before accepting an upload.
            *@
            @if (ownsListing)
            {
                <div class="mt-3 mb-3">

                    <a asp-controller="Listings"
                       asp-action="AddPhoto"
                       asp-route-id="@Model.ListingID"
                       class="btn btn-success">
                        Add Photo
                    </a>

                </div>
            }

            <hr />

            @* Show the main details stored for the listing. *@
            <dl class="row">

                <dt class="col-sm-6">
                    CLS Number
                </dt>

                <dd class="col-sm-6">
                    @Model.CLSNumber
                </dd>

                <dt class="col-sm-6">
                    Status
                </dt>

                <dd class="col-sm-6">
                    @Model.PropertyStatus
                </dd>

                <dt class="col-sm-6">
                    Property Type
                </dt>

                <dd class="col-sm-6">
                    @Model.PropertyType
                </dd>

                <dt class="col-sm-6">
                    Bedrooms
                </dt>

                <dd class="col-sm-6">
                    @Model.Bedrooms
                </dd>

                <dt class="col-sm-6">
                    Bathrooms
                </dt>

                <dd class="col-sm-6">
                    @Model.Bathrooms
                </dd>

                @* Only show square footage when a value exists. *@
                @if (Model.SquareFeet.HasValue)
                {
                    <dt class="col-sm-6">
                        Square Feet
                    </dt>

                    <dd class="col-sm-6">
                        @Model.SquareFeet.Value.ToString("N0")
                    </dd>
                }

                @* Year built is optional, so hide the row when no value was entered. *@
                @if (Model.YearBuilt.HasValue)
                {
                    <dt class="col-sm-6">
                        Year Built
                    </dt>

                    <dd class="col-sm-6">
                        @Model.YearBuilt
                    </dd>
                }

                @* HOA fees are optional, so only show them when a value exists. *@
                @if (Model.HOAFees.HasValue)
                {
                    <dt class="col-sm-6">
                        HOA Fees
                    </dt>

                    <dd class="col-sm-6">
                        @Model.HOAFees.Value.ToString("C")
                    </dd>
                }

                @*
                    The listing member is loaded with the listing
                    so the member's name can be displayed here.
                *@
                <dt class="col-sm-6">
                    Listing Member
                </dt>

                <dd class="col-sm-6">
                    @Model.Member.FirstName @Model.Member.LastName
                </dd>

            </dl>

            @* Only show the description section when the listing has one. *@
            @if (!string.IsNullOrWhiteSpace(Model.ListingDescription))
            {
                <hr />

                <h4>
                    Description
                </h4>

                <p>
                    @Model.ListingDescription
                </p>
            }

        </div>

    </div>

</div>